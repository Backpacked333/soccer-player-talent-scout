# Copy to .env only if overriding defaults. Never commit the resulting .env.
SCOUT_ENVIRONMENT=development
# Default database is an absolute path to .local/scout.db under this repository.
# SCOUT_DATABASE_URL=sqlite:////absolute/path/to/private/scout.db
# PostgreSQL path: make setup BACKEND_EXTRAS="--extra dev --extra postgres".
# Pass the same BACKEND_EXTRAS to make db/api/worker so uv retains the driver.
# Use a private database; a live PostgreSQL server was not validated here.
# SCOUT_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/scoutroom
# Default storage is .local/storage under this repository, never frontend/public.
# SCOUT_STORAGE_ROOT=/absolute/path/to/private/storage
SCOUT_ALLOWED_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'
SCOUT_COOKIE_SECURE=false
SCOUT_SESSION_TTL_HOURS=24
SCOUT_ALLOW_SIGNUP=true
# Default 8 GiB; validated configurable ceiling 16 GiB. Uploads remain streamed.
SCOUT_MAX_UPLOAD_BYTES=8589934592
SCOUT_MAX_VIDEO_SECONDS=10800
SCOUT_MAX_VIDEO_DIMENSION=4096
SCOUT_PROBE_TIMEOUT_SECONDS=30
SCOUT_FFPROBE_BINARY=ffprobe
SCOUT_WORKER_POLL_SECONDS=2
SCOUT_WORKER_LEASE_SECONDS=300
SCOUT_MAX_JOB_ATTEMPTS=3
# Whole-source detector processing uses bounded durable chunks, not a video prefix.
SCOUT_PROCESSING_CHUNK_SECONDS=120
SCOUT_PROCESSING_SAMPLE_INTERVAL_SECONDS=0.5
SCOUT_PROCESSING_MAX_CHUNKS=1440
SCOUT_PROCESSING_OBSERVATION_BATCH_SIZE=500
SCOUT_PROCESSING_MAX_CHUNK_ATTEMPTS=3
# Development creates a private local key on demand. No fixed default secret.
# Production MUST set a random secret >=32 chars, secure cookies and HTTPS origins.
# SCOUT_SECRET_KEY=<supply-via-environment-or-private-env-file>
# SCOUT_ENVIRONMENT=production
# SCOUT_COOKIE_SECURE=true
# SCOUT_ALLOWED_ORIGINS='["https://your-private-scouting-host.example"]'
# For an explicitly approved HTTPS preview, use its exact origin above and
# secure cookies; expose only the Vite proxy, never private API/media storage.
# This is a local preview configuration, not a production deployment recipe.
# Optional patched CPU detection remains disabled without operator checkpoint,
# rights/security review, exact checksum/class mapping and separate dependencies.
# See docs/FULL_MATCH.md; no GPU, model download or hosted inference is enabled.
SCOUT_VISION_ENABLED=false
# Optional bounded JSON spatial model, outside upload storage. No artifact shipped.
# The exact workspace/mode/cohort and CURRENT training evidence must match.
# SCOUT_ACTION_VALUE_ARTIFACT_PATH=/private/operator-models/research-model.json
# No client-controlled model upload/path/URL is supported; see docs/ALGORITHMS.md.
